      "binding": "DB",
      "database_id": "7928e7a2-fb8f-42ba-b02c-e9907ff5062d",
      "database_name": "are-you-ai-demo"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "image_list",
      "id": "a9dfc3b886db41389fd0bbe1cc65788c"
    },
    {
      "binding": "ai_description",
      "id": "c458f3696c7c486192ccb25e3b5c2a07"
    }
  ],
